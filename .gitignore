# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local server store (brands, facts, creatives, uploads)
.data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# hackathon additions
# generated run metadata (images under public/runs/ ARE committed for the golden run)
.runs/
tapes/
# scripts/test-creative-engine.ts writes its own run directories under
# public/runs/ — test fixtures, not the golden run. Hyphenated glob so a
# future bare public/runs/test-creative-run/ (or .../golden/) is never swallowed.
public/runs/test-creative-run-*/
!.env.local.example

# band-swarm (Python Band agents): credentials stay local, template is committed
!band-swarm/.env.example
band-swarm/.venv/
__pycache__/

# local-only progress tracking, never commit
PROGRESS.md
