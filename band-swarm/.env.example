# band-swarm credentials — copy to band-swarm/.env and fill in.
#
# Create SEVEN remote agents in the Band dashboard (app.band.ai → docs at
# docs.band.ai/getting-started/connect-remote-agent), one per role below.
# Each agent gets its own UUID + API key — paste both here.

CONDUCTOR_AGENT_ID=
CONDUCTOR_API_KEY=
CARTOGRAPHER_AGENT_ID=
CARTOGRAPHER_API_KEY=
SCOUT_AGENT_ID=
SCOUT_API_KEY=
ANALYST_AGENT_ID=
ANALYST_API_KEY=
CRITIC_AGENT_ID=
CRITIC_API_KEY=
PERSONASMITH_AGENT_ID=
PERSONASMITH_API_KEY=
COMPETITOR_AGENT_ID=
COMPETITOR_API_KEY=

# Claude brain for every agent (console.anthropic.com)
ANTHROPIC_API_KEY=

# Your personal Band USER API key. Not used by the swarm itself — reserved for
# the in-app war-room UI (full-room transcript + posting pings as yourself via
# GET/POST /api/v1/me/chats/{id}/messages).
BAND_USER_API_KEY=

# Optional overrides
# SWARM_MODEL=claude-sonnet-4-5          # Anthropic model id for all agents
# APP_BASE=http://localhost:3002         # SwarmAds app the swarm reports into
# BAND_ROOM_ID=                          # pin kickoff.py to a specific Band chat UUID
# KICKOFF_TIMEOUT_S=360                  # how long kickoff.py waits for facts

# Band Cloud is the default — only set these for self-hosted Band.
# BAND_REST_URL=https://app.band.ai
# BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket
