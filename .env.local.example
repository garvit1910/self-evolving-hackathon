# Copy to .env.local and fill in as keys arrive. Unset = that sponsor stays mock.

# --- per-sponsor real toggles (1 = use real API, else mock) ---
USE_REAL_SENSO=0
USE_REAL_PIONEER=0
USE_REAL_ACTIAN=0
USE_REAL_BAND=0
USE_REAL_GEMINI=0

# --- golden-run tape: live | record | replay ---
TAPE_MODE=live

# --- Pioneer / Fastino (OpenAI-compatible) ---
PIONEER_BASE_URL=
PIONEER_API_KEY=
PIONEER_MODEL=

# --- Band ---
# Live path: the six-agent Python swarm — credentials live in band-swarm/.env
# (see band-swarm/.env.example), NOT here. Start it with:
#   cd band-swarm && uv run python run_swarm.py
# The vars below only feed the LEGACY single-identity TS client
# (BAND_KICKOFF=ts + src/agents/swarm.ts).
BAND_REST_URL=https://app.band.ai
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket
BAND_AGENT_ID=
BAND_API_KEY=

# --- Senso ---
SENSO_BASE_URL=https://apiv2.senso.ai/api/v1
SENSO_API_KEY=

# --- Actian (local Docker; Vercel cannot reach this) ---
ACTIAN_URL=http://localhost:8080

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
